[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "CopyJSONReference",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/CopyJSONReference/CopyJSONReference.sublime-settings",
                                    "default": "// CopyJSONReference Settings\n//\n// Copy any of these keys into this file to override the defaults.\n{\n\t// Prepend a leading dot (jq-style). Default: false\n\t// \"leading_dot\": false,\n\n\t// Separator used when multiple selections are copied. Default: newline\n\t// \"multi_separator\": \"\\n\"\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
